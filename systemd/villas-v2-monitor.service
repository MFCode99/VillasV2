[Unit]
Description=Villas V2 automatic health monitor
After=network-online.target villas-v2.service

[Service]
Type=oneshot
User=nunogouveia
Group=nunogouveia
WorkingDirectory=/home/nunogouveia/villas-v2
EnvironmentFile=/home/nunogouveia/villas-v2/.env
ExecStart=/home/nunogouveia/villas-v2/.venv/bin/python scripts/monitor_system.py
